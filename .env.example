# Server Configuration
PORT=3000
SERVICE_NAME=rust-srv-template
SERVICE_ENV=DEV
DEBUG_LEVEL=info
CORS_ORIGINS=*
DRAIN_TIMEOUT_SECS=10
REQUEST_TIMEOUT_SECS=30
ENABLE_MSGPACK=true

# Database Configuration
MONGO_URL=mongodb://localhost:27017
MONGO_DB=rust_srv_template

# Optional: Redis Configuration
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_PREFIX=SRV:SBX:

# Google Cloud Project ID (Optional, for GCP Cloud Trace)
PROJECT_ID=
