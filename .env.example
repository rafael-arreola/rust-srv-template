# Service
SERVICE_NAME=rust-srv-template
SERVICE_ENV=DEV
PROJECT_ID=
DEBUG_LEVEL=info

# HTTP
PORT=3000
CORS_ORIGINS=*
DRAIN_TIMEOUT_SECS=8
REQUEST_TIMEOUT_SECS=30
BODY_LIMIT_BYTES=33554432
ENABLE_MSGPACK=true

# Databases
MONGO_URL=mongodb://localhost:27017
MONGO_DB=rust_srv_template
REDIS_URL=
REDIS_PREFIX=rust-srv-template

# Integrations
CARRIER_URL=
CARRIER_API_KEY=

# Tests
MONGO_TEST_URL=mongodb://localhost:27017
